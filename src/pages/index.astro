---
import HeadBase from "../components/HeadBase.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { FULL_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <HeadBase title={FULL_TITLE} image="/aql2027-logo.png" />
  </head>
  <body class="bg-white text-gray-900">
    <Header />

    <main>
      <section class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 px-4 py-16 text-white md:py-24">
        <div class="container mx-auto max-w-5xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-blue-100 md:text-base">Save the Date</p>

          <h1 class="mx-auto mt-6 max-w-4xl text-3xl font-bold leading-tight md:text-5xl">
            The 17th International Conference on Advances in Quantitative Laryngology, Voice and Speech Research
          </h1>

          <div class="mx-auto mt-10 grid max-w-3xl gap-4 md:grid-cols-2">
            <div class="rounded-2xl border border-white/30 bg-white/10 px-6 py-5 shadow-lg backdrop-blur-sm">
              <p class="text-sm font-semibold uppercase tracking-wider text-blue-100">Dates</p>
              <p class="mt-2 text-2xl font-bold">
                <time datetime="2027-06-01">June 1–3, 2027</time>
              </p>
            </div>

            <div class="rounded-2xl border border-white/30 bg-white/10 px-6 py-5 shadow-lg backdrop-blur-sm">
              <p class="text-sm font-semibold uppercase tracking-wider text-blue-100">Location</p>
              <p class="mt-2 text-2xl font-bold">Boston, Massachusetts, USA</p>
            </div>
          </div>
        </div>
      </section>

      <section class="px-4 py-14 md:py-20">
        <div class="container mx-auto max-w-3xl text-center">
          <h2 class="text-3xl font-bold text-blue-900">Conference information</h2>
          <p class="mt-5 text-lg leading-8 text-gray-700">
            Additional information regarding abstract submissions, registration, accommodations, the venue, and the scientific program will be announced here as it becomes available.
          </p>

          <div class="mt-9 rounded-2xl bg-gray-100 px-6 py-7">
            <p class="font-semibold text-gray-800">Questions or updates?</p>
            <a
              href="mailto:conferenceaql@gmail.com"
              class="mt-2 inline-block text-lg font-bold text-blue-800 underline decoration-2 underline-offset-4 transition hover:text-blue-600"
            >
              conferenceaql@gmail.com
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
